import solvers.«62.windows.source»

/-! Successful closed windows give full source equivalence, including heap observations. -/
set_option Elab.async false
namespace solvers.«62».source_equivalence
open FormalSW.PyAst
open ProjectEulerSolutions.CubicSearch
open data.«project-euler-statements».data.py.project_euler_statements.p62
private abbrev number (n : Int) : Mutable.Value := .scalar (.int n)

def left (target : Int) (caller : Mutable.Heap) : Mutable.CallFamily :=
  SetCalls.call Solvers.P62Ast.module "solve" [number target] caller

def right (limit : Nat) (target : Int) (caller : Mutable.Heap) : Mutable.CallFamily :=
  SetCalls.call P62Ast.module "_search_window" [number limit, number target] caller

/-- Both original calls return and have equivalent observable outcomes for every independent schedule. -/
def Verified (limit : Nat) (target : Int) (caller : Mutable.Heap) : Prop :=
  (left target caller).Returns ∧ (right limit target caller).Returns ∧
    (left target caller).Equiv (right limit target caller)

theorem verified (limit : Nat) (target : Int) (caller : Mutable.Heap) (valid : caller.Valid)
    (closed : width limit < width (limit + 1)) (success : window.answer limit target ≠ 0) :
    Verified limit target caller := by
  obtain ⟨finalHeap, rightExtra, optimized, preserved, reference⟩ := closed_window.result limit target caller closed success
  let leftExtra := finalHeap.drop caller.length
  have layout : finalHeap = caller ++ leftExtra := by
    calc
      finalHeap = finalHeap.take caller.length ++ finalHeap.drop caller.length :=
        (List.take_append_drop caller.length finalHeap).symm
      _ = caller ++ leftExtra := by rw [preserved]
  rw [layout] at optimized
  refine ⟨SetCalls.returns_of_heap optimized.returns, SetCalls.returns_of_heap reference.returns, ?_⟩
  intro leftChoices rightChoices
  have leftRun : ((left target caller).run leftChoices).Finishes
      ⟨.ok (number (window.answer limit target)), [], caller ++ leftExtra, caller.length⟩ :=
    SetCalls.finishes_of_heap optimized.finishes leftChoices 0
  have rightRun : ((right limit target caller).run rightChoices).Finishes
      ⟨.ok (number (window.answer limit target)), [], caller ++ rightExtra, caller.length⟩ :=
    SetCalls.finishes_of_heap reference.finishes rightChoices 0
  constructor
  · intro outcome finished
    refine ⟨_, rightRun, ?_⟩
    rw [Mutable.Call.unique finished leftRun]
    exact Mutable.Completion.equivalent_allocations caller leftExtra rightExtra _ [] valid (by trivial) (by simp)
  · intro outcome finished
    refine ⟨_, leftRun, ?_⟩
    rw [Mutable.Call.unique finished rightRun]
    exact Mutable.Completion.equivalent_allocations caller leftExtra rightExtra _ [] valid (by trivial) (by simp)

theorem supported (limit : Nat) (target : Int) (caller : Mutable.Heap) (valid : caller.Valid)
    (closed : width limit < width (limit + 1)) (success : window.answer limit target ≠ 0) :
    (left target caller).Supported ∧ (right limit target caller).Supported := by
  have checked := verified limit target caller valid closed success
  exact ⟨fun choices => (checked.1 choices).supported, fun choices => (checked.2.1 choices).supported⟩

end solvers.«62».source_equivalence

namespace solvers.«62»
open FormalSW.PyAst
open ProjectEulerSolutions.CubicSearch
open data.«project-euler-statements».data.py.project_euler_statements.p62

theorem solve_source_equivalence (limit : Nat) (target : Int) (caller : Mutable.Heap) :
    caller.Valid → width limit < width (limit + 1) → window.answer limit target ≠ 0 →
      source_equivalence.Verified limit target caller := source_equivalence.verified limit target caller

end solvers.«62»
