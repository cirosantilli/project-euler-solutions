import solvers.«79.py.lean.d».AllocationTerminal
import solvers.«79.py.lean.d».AllocationResult
import solvers.«79.py.lean.d».Terminal
import solvers.«79.py.lean.d».Execution
import data.«project-euler-statements».data.py.project_euler_statements.«p79.py»
import lang.py.FormalSW.SetChoiceCalls
import lang.py.FormalSW.IteratorLifting
import lang.py.FormalSW.PossibleChoices
import lang.py.FormalSW.MutableRelocation
import lang.py.FormalSW.RuntimeExceptionObservation
